@{
    ViewData["Title"] = "Pedido en Proceso";
    int numeroMesa = ViewBag.NumeroMesa ?? 0;
}

<div class="container text-center py-5" style="max-width: 500px;">
    <div class="card shadow-lg border-0 p-4">
        <div class="card-body">
            <div class="display-1 text-warning mb-3">⏳</div>
            <h3 class="fw-bold">¡Tu pedido está en proceso!</h3>
            <p class="text-muted">
                La <strong>Mesa @numeroMesa</strong> ya cuenta con una orden activa enviada a cocina.
            </p>
            
            <div class="alert alert-info mt-4" role="alert">
                <i class="bi bi-info-circle"></i> 
                Si deseas pedir algo adicional o realizar tu pago, por favor solicita la atención de un mesero o dirígete a caja.
            </div>

            <p class="small text-muted mt-3 mb-0">
                Una vez liquidada la cuenta en caja, la mesa quedará disponible nuevamente.
            </p>
        </div>
    </div>
</div>